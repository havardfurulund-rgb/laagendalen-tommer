# Frontend (safe to expose via Vite)
VITE_API_KEY=your_google_genai_api_key_here

# --- Server-only (Vercel Project → Settings → Environment Variables) ---
# NEVER prefix merchant secrets with VITE_

# Provider override (optional): stripe | vipps
# Default: Stripe if STRIPE_SECRET_KEY set, else Vipps if VIPPS_* complete
CHECKOUT_PROVIDER=

# Stripe (temporary / CoS GO)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Vipps ePayment (when merchant keys arrive)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
# alias accepted:
# VIPPS_OCP_APIM_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_API_URL=https://apitest.vipps.no
VIPPS_WEBHOOK_SECRET=
